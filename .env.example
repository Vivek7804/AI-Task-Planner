# Copy this file to .env and enter your key locally. Never commit .env.
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: set this for another OpenAI-compatible API provider.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
# Set true to force local deterministic demo mode. Defaults to demo mode if no key exists.
DEMO_MODE=true
